{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "types": ["node", "vscode"],
    "sourceMap": true
  },
  "include": [
    "webview-src/**/*.ts",
    "src/webview/graph-protocol.ts",
    "src/artifacts/control-flow-graph/control-flow-graph-model.ts",
    "src/artifacts/control-flow-graph/graph-structure.ts",
    "src/types/**/*.ts",
    "src/artifacts/core/artifact-contracts.ts"
  ]
}
