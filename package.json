        "defaults": {
          "dark": "#4FC3F7",
          "light": "#0277BD",
          "highContrast": "#00FFFF",
          "highContrastLight": "#005A9C"
        }
      },
      {
        "id": "coglens.sourceLineBand.2Background",
        "description": "Second source-line mapping band.",
        "defaults": {
          "dark": "#AED58122",
          "light": "#558B2F18",
          "highContrast": "#00000000",
          "highContrastLight": "#00000000"
        }
      },
      {
        "id": "coglens.sourceLineBand.2Marker",
        "description": "Marker for the second source-line mapping band.",
        "defaults": {
          "dark": "#AED581",
          "light": "#558B2F",
          "highContrast": "#00FF00",
          "highContrastLight": "#256D1B"
        }
      },
      {
        "id": "coglens.sourceLineBand.3Background",
        "description": "Third source-line mapping band.",
        "defaults": {
          "dark": "#FFD54F22",
          "light": "#F57F1718",
          "highContrast": "#00000000",
          "highContrastLight": "#00000000"
        }
      },
      {
        "id": "coglens.sourceLineBand.3Marker",
        "description": "Marker for the third source-line mapping band.",
        "defaults": {
          "dark": "#FFD54F",
          "light": "#F57F17",
          "highContrast": "#FFFF00",
          "highContrastLight": "#8A4B00"
        }
      },
      {
        "id": "coglens.sourceLineBand.4Background",
        "description": "Fourth source-line mapping band.",
        "defaults": {
          "dark": "#FF8A8022",
          "light": "#C6282818",
          "highContrast": "#00000000",
          "highContrastLight": "#00000000"
        }
      },
      {
        "id": "coglens.sourceLineBand.4Marker",
        "description": "Marker for the fourth source-line mapping band.",
        "defaults": {
          "dark": "#FF8A80",
          "light": "#C62828",
          "highContrast": "#FF8080",
          "highContrastLight": "#9C0000"
        }
      },
      {
        "id": "coglens.sourceLineBand.5Background",
        "description": "Fifth source-line mapping band.",
        "defaults": {
          "dark": "#CE93D822",
          "light": "#7B1FA218",
          "highContrast": "#00000000",
          "highContrastLight": "#00000000"
        }
      },
      {
        "id": "coglens.sourceLineBand.5Marker",
        "description": "Marker for the fifth source-line mapping band.",
        "defaults": {
          "dark": "#CE93D8",
          "light": "#7B1FA2",
          "highContrast": "#FF80FF",
          "highContrastLight": "#611078"
        }
      },
      {
        "id": "coglens.sourceLineBand.6Background",
        "description": "Sixth source-line mapping band.",
        "defaults": {
          "dark": "#80CBC422",
          "light": "#00796B18",
          "highContrast": "#00000000",
          "highContrastLight": "#00000000"
        }
      },
      {
        "id": "coglens.sourceLineBand.6Marker",
        "description": "Marker for the sixth source-line mapping band.",
        "defaults": {
          "dark": "#80CBC4",
          "light": "#00796B",
          "highContrast": "#80FFFF",
          "highContrastLight": "#00665B"
        }
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "coglens",
          "title": "Cogitator Lens",
          "icon": "resources/gear-phi.svg"
        }
      ]
    },
    "views": {
      "coglens": [
        {
          "id": "coglens.toolchains",
          "name": "Toolchains",
          "icon": "$(blank)"
        },
        {
          "id": "coglens.compileInfo",
          "name": "Project Compile Info",
          "icon": "$(blank)"
        },
        {
          "id": "coglens.artifactOptions",
          "name": "Artifact Options",
          "icon": "$(filter)"
        },
        {
          "id": "coglens.artifactPresets",
          "name": "Artifact Presets",
          "icon": "$(symbol-parameter)"
        },
        {
          "id": "coglens.artifactDetails",
          "name": "Artifact Details",
          "icon": "$(info)"
        }
      ]
    },
    "commands": [
      {
        "command": "coglens.OpenArtifact",
        "title": "Open Artifact",
        "category": "Cogitator Lens",
        "enablement": "coglens.supportedSource",
        "icon": "$(preview)"
      },
      {
        "command": "coglens.OpenControlFlowGraph",
        "title": "Open Control-Flow Graph",
        "category": "Cogitator Lens",
        "enablement": "coglens.supportedSource",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "coglens.CompareArtifacts",
        "title": "Compare Artifacts",
        "category": "Cogitator Lens",
        "enablement": "coglens.supportedSource",
        "icon": "$(diff)"
      },
      {
        "command": "coglens.CopyText",
        "title": "Copy Text",
        "category": "Cogitator Lens",
        "icon": "$(clippy)"
      },
      {
        "command": "coglens.DeleteToolchain",
        "title": "Delete Toolchain",
        "category": "Cogitator Lens",
        "icon": "$(trash)"
      },
      {
        "command": "coglens.AddToolchain",
        "title": "Add Toolchain",
        "category": "Cogitator Lens",
        "icon": "$(add)"
      },
      {
        "command": "coglens.PickCompilationVariant",
        "title": "Select Compilation Variant",
        "category": "Cogitator Lens",
        "enablement": "coglens.supportedSource",
        "icon": "$(list-selection)"
      },
      {
        "command": "coglens.CreateWorkspaceOverride",
        "title": "Create Workspace Override",
        "category": "Cogitator Lens",
        "icon": "$(copy)"
      },
      {
        "command": "coglens.AddCompilationVariant",
        "title": "Add Workspace Compilation Variant",
        "category": "Cogitator Lens",
        "icon": "$(add)"
      },
      {
        "command": "coglens.EditCompilationVariant",
        "title": "Edit as Workspace Compilation Variant",
        "category": "Cogitator Lens",
        "icon": "$(edit)"
      },
      {
        "command": "coglens.DeleteCompilationVariant",
        "title": "Delete Workspace Compilation Variant",
        "category": "Cogitator Lens",
        "icon": "$(trash)"
      },
      {
        "command": "coglens.RevealActiveSource",
        "title": "Reveal Active Source",
        "category": "Cogitator Lens",
        "icon": "$(go-to-file)"
      },
      {
        "command": "coglens.OpenToolchainSettingsJson",
        "title": "Open Toolchain Settings JSON",
        "category": "Cogitator Lens",
        "icon": "$(json)"
      },
      {
        "command": "coglens.OpenCompileSettingsJson",
        "title": "Open Compile Settings JSON",
        "category": "Cogitator Lens",
        "icon": "$(json)"
      },
      {
        "command": "coglens.OpenArtifactSettingsJson",
        "title": "Open Artifact Settings JSON",
        "category": "Cogitator Lens",
        "icon": "$(json)"
      },
      {
        "command": "coglens.AddArtifactPreset",
        "title": "Add Artifact Preset",
        "category": "Cogitator Lens",
        "icon": "$(add)"
      },
      {
        "command": "coglens.EditArtifactPreset",
        "title": "Edit Artifact Preset",
        "category": "Cogitator Lens",
        "icon": "$(edit)"
      },
      {
        "command": "coglens.DeleteArtifactPreset",
        "title": "Delete Artifact Preset",
        "category": "Cogitator Lens",
        "icon": "$(trash)"
      },
      {
        "command": "coglens.SaveArtifactOptionsAsPreset",
        "title": "Save Current Options as Artifact Preset",
        "category": "Cogitator Lens",
        "enablement": "coglens.artifactDocument",
        "icon": "$(save-as)"
      },
      {
        "command": "coglens.OpenPresetSettingsJson",
        "title": "Open Artifact Preset Settings JSON",
        "category": "Cogitator Lens",
        "icon": "$(json)"
      },
      {
        "command": "coglens.RefreshArtifact",
        "title": "Refresh Artifact",
        "category": "Cogitator Lens",
        "enablement": "coglens.artifactDocument",
        "icon": "$(refresh)"
      },
      {
        "command": "coglens.CancelGeneration",
        "title": "Cancel Artifact Generation",
        "category": "Cogitator Lens",
        "enablement": "coglens.artifactDocument",
        "icon": "$(debug-stop)"
      },
      {
        "command": "coglens.ShowLog",
        "title": "Show Log",
        "category": "Cogitator Lens",
        "icon": "$(output)"
      },
      {
        "command": "coglens.RevealArtifactSource",
        "title": "Reveal Artifact Source",
        "category": "Cogitator Lens",
        "enablement": "coglens.artifactDocument",
        "icon": "$(go-to-file)"
      },
      {
        "command": "coglens.ShowArtifactStatus",
        "title": "Show Artifact Status and Actions",
        "category": "Cogitator Lens",
        "enablement": "coglens.artifactDocument"
      }
    ],
    "configuration": [
      {
        "title": "Cogitator Lens",
        "properties": {
          "coglens.compilationDatabases": {
            "type": "array",
            "scope": "resource",
            "default": [
              "compile_commands.json",
              "build/compile_commands.json"
            ],
            "description": "Compilation database paths resolved relative to each workspace folder. Use an empty array to disable compilation database discovery.",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "coglens.dimUnusedSourceLines": {
            "type": "boolean",
            "default": true,
            "description": "Dim lines that do not contribute to the rendered artifact",
            "scope": "resource"
          },
          "coglens.synchronizeSourceAndArtifactScrolling": {
            "type": "boolean",
            "default": true,
            "description": "Keep visible source and artifact editors aligned while scrolling",
            "scope": "resource"
          },
          "coglens.toolchains": {
            "type": "array",
            "scope": "window",
            "default": [],
            "items": {
              "type": "object",
              "title": "Toolchain configuration",
              "description": "Toolchain configuration parameters",
              "default": {},
              "required": [
                "displayName",
                "kind",
                "executable"
              ],
              "additionalProperties": false,
              "properties": {
                "displayName": {
                  "type": "string",
                  "description": "The name of this toolchain configuration"
                },
                "kind": {
                  "type": "string",
                  "description": "The type of toolchain",
                  "enum": [
                    "gcc",
                    "clang-cl",
                    "msvc",
                    "clang",
                    "apple-clang",
                    "rust",
                    "python",
                    "dotnet",
                    "go",
                    "zig",
                    "nvcc"
                  ]
                },
                "executable": {
                  "type": "string",
                  "description": "The path to the toolchain executable"
                },
                "defaultArguments": {
                  "type": "array",
                  "description": "Arguments provided to the toolchain",
                  "items": {
                    "type": "string"
                  },
                  "default": []
                },
                "environment": {
                  "type": "object",
                  "description": "Environment variables defined when using this toolchain",
                  "additionalProperties": {
                    "type": "string"
                  },
                  "default": {}
                },
                "tools": {
                  "type": "object",
                  "description": "Named auxiliary tools with explicit invocation metadata",
                  "additionalProperties": {
                    "type": "object",
                    "required": [
                      "executable",
                      "inputMode"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "executable": {
                        "type": "string"
                      },
                      "inputMode": {
                        "type": "string",
                        "enum": [
                          "stdin",
                          "file-argument"
                        ]
                      }
                    }
                  },
                  "default": {}
                }
              }
            }
          },
          "coglens.defaultInvocation": {
            "type": "object",
            "scope": "resource",
            "title": "Default Invocation",
            "description": "Default invocation for files with no discovered compilation variant",
            "default": {},
            "required": [
              "toolchain"
            ],
            "additionalProperties": false,
            "properties": {
              "toolchain": {
                "type": "string",
                "description": "Toolchain name matching an entry in coglens.toolchains",
                "default": ""
              },
              "args": {
                "type": "array",
                "description": "Arguments provided to the selected toolchain",
                "items": {
                  "type": "string"
                },
                "default": []
              },
              "env": {
                "type": "object",
                "description": "Environment variables defined for artifact production",
                "additionalProperties": {
                  "type": "string"
                },
                "default": {}
              },
              "workingDirectory": {
                "type": "string",
                "description": "Working directory used for artifact production"
              }
            }
          },
          "coglens.compileVariants": {
            "type": "array",
            "scope": "window",
            "default": [],
            "description": "Workspace-owned compilation variants. Use the Project Compile Info sidebar to add and edit entries.",
            "items": {
              "type": "object",
              "title": "Workspace compilation variant",
              "required": [
                "id",
                "source",
                "displayLabel",
                "toolchainProfileId",
                "workingDirectory",
                "arguments",
                "environment"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "description": "Stable variant identifier"
                },
                "source": {
                  "type": "string",
                  "description": "Absolute path to the source file"
                },
                "displayLabel": {
                  "type": "string",
                  "description": "Name shown in variant pickers and the sidebar"
                },
                "toolchainProfileId": {
                  "type": "string",
                  "description": "Toolchain profile ID shown in the Toolchains sidebar"
                },
                "workingDirectory": {
                  "type": "string",
                  "description": "Working directory used to invoke the toolchain"
                },
                "arguments": {
                  "type": "array",
                  "description": "Arguments appended to the selected toolchain's default arguments",
                  "items": {
                    "type": "string"
                  }
                },
                "environment": {
                  "type": "object",
                  "description": "Environment variables added to the toolchain process",
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "project": {
                  "type": "string",
                  "description": "Optional project grouping label"
                },
                "target": {
                  "type": "string",
                  "description": "Optional target grouping label"
                },
                "configuration": {
                  "type": "string",
                  "description": "Optional configuration grouping label"
                }
              }
            }
          },
          "coglens.artifactOptions": {
            "type": "object",
            "scope": "resource",
            "default": {
              "assembly": {
                "intel": false,
                "demangle": false,
                "labels": true,
                "libraryCode": false,
                "directives": true,
                "commentOnly": true,
                "trim": false,
                "dontMaskFilenames": true,
                "binaryColumns": true,
                "sourceLineColorBands": true
              },
              "binary-disassembly": {
                "labels": true,
                "libraryCode": false,
                "dontMaskFilenames": true,
                "binaryColumns": true,
                "sourceLineColorBands": true
              },
              "preprocessed-source": {
                "showIncludedFiles": true
              },
              "ast": {
                "showSystemDeclarations": false
              },
              "llvm-ir": {
                "sourceLineColorBands": true
              }
            },
            "additionalProperties": false,
            "properties": {
              "assembly": {
                "type": "object",
                "title": "Assembly options",
                "description": "Assembly options",
                "additionalProperties": false,
                "properties": {
                  "intel": {
                    "type": "boolean",
                    "title": "Intel syntax",
                    "default": false,
                    "description": "Emit Intel syntax when supported by the selected toolchain"
                  },
                  "demangle": {
                    "type": "boolean",
                    "title": "Demangle symbols",
                    "default": false,
                    "description": "Run the configured demangler before rendering assembly"
                  },
                  "labels": {
                    "type": "boolean",
                    "title": "Hide unused labels",
                    "default": true,
                    "description": "Remove labels that are not referenced"
                  },
                  "libraryCode": {
                    "type": "boolean",
                    "title": "Hide library code",
                    "default": false,
                    "description": "Hide code from system libraries"
                  },
                  "directives": {
                    "type": "boolean",
                    "title": "Hide directives",
                    "default": true,
                    "description": "Hide assembler directives"
                  },
                  "commentOnly": {
                    "type": "boolean",
                    "title": "Hide comment-only lines",
                    "default": true,
                    "description": "Remove comment-only lines"
                  },
                  "trim": {
                    "type": "boolean",
                    "title": "Trim horizontal whitespace",
                    "default": false,
                    "description": "Remove excessive horizontal whitespace"
                  },
                  "dontMaskFilenames": {
                    "type": "boolean",
                    "title": "Show full filenames",
                    "default": true,
                    "description": "Keep source filenames visible in rendered output"
                  },
                  "binaryColumns": {
                    "type": "boolean",
                    "title": "Show address and opcode columns",
                    "default": true,
                    "description": "Show parsed instruction addresses and encoded bytes beside the listing"
                  },
                  "sourceLineColorBands": {
                    "type": "boolean",
                    "title": "Show source-line color bands",
                    "default": true,
                    "description": "Use stable color bands to connect source lines with generated output"
                  }
                }
              },
              "binary-disassembly": {
                "type": "object",
                "title": "Binary disassembly options",
                "description": "Binary disassembly options",
                "additionalProperties": false,
                "properties": {
                  "labels": {
                    "type": "boolean",
                    "title": "Hide unused labels",
                    "default": true,
                    "description": "Remove labels that are not referenced"
                  },
                  "libraryCode": {
                    "type": "boolean",
                    "title": "Hide library code",
                    "default": false,
                    "description": "Hide code from system libraries"
                  },
                  "dontMaskFilenames": {
                    "type": "boolean",
                    "title": "Show full filenames",
                    "default": true,
                    "description": "Keep source filenames visible in rendered output"
                  },
                  "binaryColumns": {
                    "type": "boolean",
                    "title": "Show address and opcode columns",
                    "default": true,
                    "description": "Show parsed instruction addresses and encoded bytes beside the listing"
                  },
                  "sourceLineColorBands": {
                    "type": "boolean",
                    "title": "Show source-line color bands",
                    "default": true,
                    "description": "Use stable color bands to connect source lines with generated output"
                  }
                }
              },
              "preprocessed-source": {
                "type": "object",
                "title": "Preprocessed source options",
                "description": "Preprocessed source options",
                "additionalProperties": false,
                "properties": {
                  "showIncludedFiles": {
                    "type": "boolean",
                    "title": "Show included files",
                    "default": true,
                    "description": "Include content originating from headers in preprocessed output"
                  }
                }
              },
              "ast": {
                "type": "object",
                "title": "Abstract syntax tree options",
                "description": "Abstract syntax tree options",
                "additionalProperties": false,
                "properties": {
                  "showSystemDeclarations": {
                    "type": "boolean",
                    "title": "Show system declarations",
                    "default": false,
                    "description": "Include declarations originating from compiler and system headers"
                  }
                }
              },
              "llvm-ir": {
                "type": "object",
                "title": "LLVM IR options",
                "description": "LLVM IR options",
                "additionalProperties": false,
                "properties": {
                  "sourceLineColorBands": {
                    "type": "boolean",
                    "title": "Show source-line color bands",
                    "default": true,
                    "description": "Use stable color bands to connect source lines with generated output"
                  }
                }
              },
              "rust-mir": {
                "type": "object",
                "title": "Rust MIR options",
                "description": "Rust MIR options",
                "additionalProperties": false,
                "properties": {}
              },
              "optimization-remarks": {
                "type": "object",
                "title": "Optimization remarks options",
                "description": "Optimization remarks options",
                "additionalProperties": false,
                "properties": {}
              },
              "stack-analysis": {
                "type": "object",
                "title": "Stack analysis options",
                "description": "Stack analysis options",
                "additionalProperties": false,
                "properties": {}
              },
              "control-flow-graph": {
                "type": "object",
                "title": "Control-flow graph options",
                "description": "Control-flow graph options",
                "additionalProperties": false,
                "properties": {}
              }
            }
          },
          "coglens.artifactPresets": {
            "type": "object",
            "scope": "resource",
            "default": {},
            "description": "Named artifact production presets",
            "additionalProperties": {
              "type": "object",
              "required": [
                "artifactKind"
              ],
              "additionalProperties": false,
              "properties": {
                "artifactKind": {
                  "type": "string",
                  "enum": [
                    "assembly",
                    "binary-disassembly",
                    "preprocessed-source",
                    "ast",
                    "llvm-ir",
                    "rust-mir",
                    "optimization-remarks",
                    "stack-analysis",
                    "control-flow-graph"
                  ],
                  "description": "Artifact kind produced by this preset"
                },
                "extraArguments": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "default": [],
                  "description": "Additional arguments appended to the compilation variant"
                },
                "productionOptions": {
                  "type": "object",
                  "additionalProperties": false,
                  "default": {},
                  "properties": {
                    "intel": {
                      "type": "boolean",
                      "title": "Intel syntax",
                      "description": "Emit Intel syntax when supported by the selected toolchain"
                    },
                    "demangle": {
                      "type": "boolean",
                      "title": "Demangle symbols",
                      "description": "Run the configured demangler before rendering assembly"
                    }
                  }
                }
              }
            }
          }
        }
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "coglens.OpenArtifact",
          "group": "navigation@1",
          "when": "resourceScheme == file && coglens.supportedSource"
        },
        {
          "command": "coglens.RevealArtifactSource",
          "group": "navigation@1",
          "when": "resourceScheme == coglens-artifact"
        }
      ],
      "view/title": [
        {
          "command": "coglens.AddToolchain",
          "when": "view == coglens.toolchains",
          "group": "navigation@1"
        },
        {
          "command": "coglens.OpenToolchainSettingsJson",
          "when": "view == coglens.toolchains",
          "group": "navigation@9"
        },
        {
          "command": "coglens.AddCompilationVariant",
          "when": "view == coglens.compileInfo",
          "group": "navigation@1"
        },
        {
          "command": "coglens.RevealActiveSource",
          "when": "view == coglens.compileInfo",
          "group": "navigation@2"
        },
        {
          "command": "coglens.OpenCompileSettingsJson",
          "when": "view == coglens.compileInfo",
          "group": "navigation@9"
        },
        {
          "command": "coglens.OpenArtifactSettingsJson",
          "when": "view == coglens.artifactOptions",
          "group": "navigation@9"
        },
        {
          "command": "coglens.AddArtifactPreset",
          "when": "view == coglens.artifactPresets",
          "group": "navigation@1"
        },
        {
          "command": "coglens.SaveArtifactOptionsAsPreset",
          "when": "view == coglens.artifactPresets && coglens.artifactDocument",
          "group": "navigation@2"
        },
        {
          "command": "coglens.OpenPresetSettingsJson",
          "when": "view == coglens.artifactPresets",
          "group": "navigation@9"
        }
      ],
      "view/item/context": [
        {
          "command": "coglens.CopyText",
          "when": "view =~ /^coglens/ && viewItem == text"
        },
        {
          "command": "coglens.CreateWorkspaceOverride",
          "when": "view == coglens.toolchains && viewItem == derivedInstance",
          "group": "inline@1"
        },
        {
          "command": "coglens.DeleteToolchain",
          "when": "view == coglens.toolchains && viewItem == userToolchain",
          "group": "inline@1"
        },
        {
          "command": "coglens.EditCompilationVariant",
          "when": "view == coglens.compileInfo && viewItem == compilationVariant",
          "group": "inline@1"
        },
        {
          "command": "coglens.AddCompilationVariant",
          "when": "view == coglens.compileInfo && viewItem == compilationSource",
          "group": "inline@1"
        },
        {
          "command": "coglens.EditCompilationVariant",
          "when": "view == coglens.compileInfo && viewItem == manualCompilationVariant",
          "group": "inline@1"
        },
        {
          "command": "coglens.DeleteCompilationVariant",
          "when": "view == coglens.compileInfo && viewItem == manualCompilationVariant",
          "group": "inline@2"
        },
        {
          "command": "coglens.EditArtifactPreset",
          "when": "view == coglens.artifactPresets && viewItem == artifactPreset",
          "group": "inline@1"
        },
        {
          "command": "coglens.DeleteArtifactPreset",
          "when": "view == coglens.artifactPresets && viewItem == artifactPreset",
          "group": "inline@2"
        }
      ]
    },
    "keybindings": [
      {
        "command": "coglens.OpenArtifact",
        "key": "ctrl+alt+a",
        "mac": "cmd+alt+a",
        "when": "editorTextFocus && coglens.supportedSource"
      },
      {
        "command": "coglens.OpenControlFlowGraph",
        "key": "ctrl+alt+g",
        "mac": "cmd+alt+g",
        "when": "editorTextFocus && coglens.supportedSource"
      },
      {
        "command": "coglens.CompareArtifacts",
        "key": "ctrl+alt+c",
        "mac": "cmd+alt+c",
        "when": "editorTextFocus && coglens.supportedSource"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run manifest:check && npm run check-types && npm run lint && node esbuild.js",
    "watch": "node esbuild.js --watch",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run manifest:check && npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p tsconfig.extension-tests.json",
    "watch-tests": "tsc -p tsconfig.extension-tests.json -w",
    "pretest": "npm run manifest:check && npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit && tsc --noEmit -p tsconfig.unit.json && tsc --noEmit -p tsconfig.webview.json",
    "lint": "eslint src webview-src test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "manifest:generate": "node --import tsx scripts/generate-manifest.ts --write",
    "manifest:check": "node --import tsx scripts/generate-manifest.ts --check",
    "test": "npm run test:unit",
    "test:unit": "node --import tsx --test \"test/**/*.test.ts\"",
    "test:extension": "npm run compile-tests && npm run compile && node scripts/run-extension-tests.mjs",
    "vendor:check": "node scripts/vendor-check.mjs",
    "package:vsix": "vsce package --no-dependencies"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@vscode/python-extension": "^1.0.6",
    "vscode-cmake-tools": "^1.7.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "20.x",
    "@types/vscode": "1.94.0",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "tsx": "^4.20.3",
    "typescript": "^5.9.3"
  },
  "extensionPack": [
    "13xforever.language-x86-64-assembly",
    "ms-python.python"
  ]
}
