{
    "name": "coglens",
    "displayName": "Cogitator Lens",
    "description": "Divine the substratal invocations of your digital canticles",
    "version": "0.5.0",
    "icon": "resources/gear-phi.png",
    "publisher": "cbrl",
    "license": "MPL-2.0",
    "repository": {
        "type": "git",
        "url": "https://github.com/cbrl/cogitator-lens"
    },
    "engines": {
        "vscode": "^1.94.0"
    },
    "capabilities": {
        "untrustedWorkspaces": {
            "supported": false,
            "description": "Cogitator Lens invokes configured toolchains and therefore requires a trusted workspace."
        }
    },
    "categories": [
        "Programming Languages",
        "Visualization",
        "Debuggers"
    ],
    "activationEvents": [],
    "main": "./dist/extension.js",
    "contributes": {
        "languages": [
            {
                "id": "coglens-ast",
                "aliases": [
                    "Compiler AST"
                ],
                "extensions": [
                    ".ast"
                ]
            },
            {
                "id": "coglens-mir",
                "aliases": [
                    "Rust MIR"
                ],
                "extensions": [
                    ".mir"
                ]
            },
            {
                "id": "python-bytecode",
                "aliases": [
                    "Python Bytecode"
                ],
                "extensions": [
                    ".pybytecode"
                ]
            }
        ],
        "grammars": [
            {
                "language": "coglens-ast",
                "scopeName": "source.coglens-ast",
                "path": "./syntaxes/coglens-ast.tmLanguage.json"
            },
            {
                "language": "coglens-mir",
                "scopeName": "source.coglens-mir",
                "path": "./syntaxes/coglens-mir.tmLanguage.json"
            },
            {
                "language": "python-bytecode",
                "scopeName": "source.python-bytecode",
                "path": "./syntaxes/python-bytecode.tmLanguage.json"
            }
        ],
        "colors": [
            {
                "id": "coglens.optimizationRemarks.passedBackground",
                "description": "Background color for successful optimization remarks.",
                "defaults": {
                    "dark": "#125C12",
                    "light": "#A9FFA9",
                    "highContrast": "#125C12",
                    "highContrastLight": "#A9FFA9"
                }
            },
            {
                "id": "coglens.optimizationRemarks.missedBackground",
                "description": "Background color for missed optimization remarks.",
                "defaults": {
                    "dark": "#631E1C",
                    "light": "#F8CAC8",
                    "highContrast": "#631E1C",
                    "highContrastLight": "#F8CAC8"
                }
            },
            {
                "id": "coglens.optimizationRemarks.analysisBackground",
                "description": "Background color for optimization analysis remarks.",
                "defaults": {
                    "dark": "#4F4F18",
                    "light": "#FFFFAE",
                    "highContrast": "#4F4F18",
                    "highContrastLight": "#FFFFAE"
                }
            }
        ],
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "coglens",
                    "title": "Cogitator Lens",
                    "icon": "resources/gear-phi.png"
                }
            ]
        },
        "views": {
            "coglens": [
                {
                    "id": "coglens.toolchains",
                    "name": "Toolchains",
                    "icon": "$(blank)"
                },
                {
                    "id": "coglens.compileInfo",
                    "name": "Project Compile Info",
                    "icon": "$(blank)"
                },
                {
                    "id": "coglens.artifactOptions",
                    "name": "Artifact Options",
                    "icon": "$(filter)"
                }
            ]
        },
        "commands": [
            {
                "command": "coglens.OpenArtifact",
                "title": "Open Artifact",
                "category": "Cogitator Lens",
                "enablement": "coglens.supportedSource",
                "icon": "$(preview)"
            },
            {
                "command": "coglens.CompareArtifacts",
                "title": "Compare Artifacts",
                "category": "Cogitator Lens",
                "enablement": "coglens.supportedSource",
                "icon": "$(diff)"
            },
            {
                "command": "coglens.CopyText",
                "title": "Copy Text",
                "category": "Cogitator Lens",
                "icon": "$(clippy)"
            },
            {
                "command": "coglens.DeleteToolchain",
                "title": "Delete Toolchain",
                "category": "Cogitator Lens",
                "icon": "$(trash)"
            },
            {
                "command": "coglens.AddToolchain",
                "title": "Add Toolchain",
                "category": "Cogitator Lens",
                "icon": "$(add)"
            },
            {
                "command": "coglens.PickCompilationVariant",
                "title": "Select Compilation Variant",
                "category": "Cogitator Lens",
                "enablement": "coglens.supportedSource",
                "icon": "$(list-selection)"
            },
            {
                "command": "coglens.CreateWorkspaceOverride",
                "title": "Create Workspace Override",
                "category": "Cogitator Lens",
                "icon": "$(copy)"
            },
            {
                "command": "coglens.AddCompilationVariant",
                "title": "Add Workspace Compilation Variant",
                "category": "Cogitator Lens",
                "icon": "$(add)"
            },
            {
                "command": "coglens.EditCompilationVariant",
                "title": "Edit as Workspace Compilation Variant",
                "category": "Cogitator Lens",
                "icon": "$(edit)"
            },
            {
                "command": "coglens.DeleteCompilationVariant",
                "title": "Delete Workspace Compilation Variant",
                "category": "Cogitator Lens",
                "icon": "$(trash)"
            },
            {
                "command": "coglens.RevealActiveSource",
                "title": "Reveal Active Source",
                "category": "Cogitator Lens",
                "icon": "$(go-to-file)"
            },
            {
                "command": "coglens.OpenToolchainSettingsJson",
                "title": "Open Toolchain Settings JSON",
                "category": "Cogitator Lens",
                "icon": "$(json)"
            },
            {
                "command": "coglens.OpenCompileSettingsJson",
                "title": "Open Compile Settings JSON",
                "category": "Cogitator Lens",
                "icon": "$(json)"
            },
            {
                "command": "coglens.OpenArtifactSettingsJson",
                "title": "Open Artifact Settings JSON",
                "category": "Cogitator Lens",
                "icon": "$(json)"
            }
        ],
        "configuration": [
            {
                "title": "Cogitator Lens",
                "properties": {
                    "coglens.compilationDatabases": {
                        "type": "array",
                        "scope": "resource",
                        "default": [
                            "compile_commands.json",
                            "build/compile_commands.json"
                        ],
                        "description": "Compilation database paths resolved relative to each workspace folder. Use an empty array to disable compilation database discovery.",
                        "items": {
                            "type": "string"
                        },
                        "uniqueItems": true
                    },
                    "coglens.dimUnusedSourceLines": {
                        "type": "boolean",
                        "default": true,
                        "description": "Dim lines that do not contribute to the rendered artifact",
                        "scope": "resource"
                    },
                    "coglens.toolchains": {
                        "type": "array",
                        "scope": "window",
                        "default": [],
                        "items": {
                            "type": "object",
                            "title": "Toolchain configuration",
                            "description": "Toolchain configuration parameters",
                            "default": {},
                            "required": [
                                "displayName",
                                "kind",
                                "executable"
                            ],
                            "additionalProperties": false,
                            "properties": {
                                "displayName": {
                                    "type": "string",
                                    "description": "The name of this toolchain configuration"
                                },
                                "kind": {
                                    "type": "string",
                                    "description": "The type of toolchain",
                                    "enum": [
                                        "gcc",
                                        "clang-cl",
                                        "msvc",
                                        "clang",
                                        "apple-clang",
                                        "rust",
                                        "python"
                                    ]
                                },
                                "executable": {
                                    "type": "string",
                                    "description": "The path to the toolchain executable"
                                },
                                "defaultArguments": {
                                    "type": "array",
                                    "description": "Arguments provided to the toolchain",
                                    "items": {
                                        "type": "string"
                                    },
                                    "default": []
                                },
                                "environment": {
                                    "type": "object",
                                    "description": "Environment variables defined when using this toolchain",
                                    "additionalProperties": {
                                        "type": "string"
                                    },
                                    "default": {}
                                },
                                "tools": {
                                    "type": "object",
                                    "description": "Named auxiliary tool executables",
                                    "additionalProperties": {
                                        "type": "string"
                                    },
                                    "default": {}
                                }
                            }
                        }
                    },
                    "coglens.defaultInvocation": {
                        "type": "object",
                        "scope": "resource",
                        "title": "Default Invocation",
                        "description": "Default invocation for files with no discovered compilation variant",
                        "default": {},
                        "required": [
                            "toolchain"
                        ],
                        "additionalProperties": false,
                        "properties": {
                            "toolchain": {
                                "type": "string",
                                "description": "Toolchain name matching an entry in coglens.toolchains",
                                "default": ""
                            },
                            "args": {
                                "type": "array",
                                "description": "Arguments provided to the selected toolchain",
                                "items": {
                                    "type": "string"
                                },
                                "default": []
                            },
                            "env": {
                                "type": "object",
                                "description": "Environment variables defined for artifact production",
                                "additionalProperties": {
                                    "type": "string"
                                },
                                "default": {}
                            },
                            "workingDirectory": {
                                "type": "string",
                                "description": "Working directory used for artifact production"
                            }
                        }
                    },
                    "coglens.compileVariants": {
                        "type": "array",
                        "scope": "window",
                        "default": [],
                        "description": "Workspace-owned compilation variants. Use the Project Compile Info sidebar to add and edit entries.",
                        "items": {
                            "type": "object",
                            "title": "Workspace compilation variant",
                            "required": [
                                "id",
                                "source",
                                "displayLabel",
                                "toolchainProfileId",
                                "workingDirectory",
                                "arguments",
                                "environment"
                            ],
                            "additionalProperties": false,
                            "properties": {
                                "id": {
                                    "type": "string",
                                    "description": "Stable variant identifier"
                                },
                                "source": {
                                    "type": "string",
                                    "description": "Absolute path to the source file"
                                },
                                "displayLabel": {
                                    "type": "string",
                                    "description": "Name shown in variant pickers and the sidebar"
                                },
                                "toolchainProfileId": {
                                    "type": "string",
                                    "description": "Toolchain profile ID shown in the Toolchains sidebar"
                                },
                                "workingDirectory": {
                                    "type": "string",
                                    "description": "Working directory used to invoke the toolchain"
                                },
                                "arguments": {
                                    "type": "array",
                                    "description": "Arguments appended to the selected toolchain's default arguments",
                                    "items": {
                                        "type": "string"
                                    }
                                },
                                "environment": {
                                    "type": "object",
                                    "description": "Environment variables added to the toolchain process",
                                    "additionalProperties": {
                                        "type": "string"
                                    }
                                },
                                "project": {
                                    "type": "string",
                                    "description": "Optional project grouping label"
                                },
                                "target": {
                                    "type": "string",
                                    "description": "Optional target grouping label"
                                },
                                "configuration": {
                                    "type": "string",
                                    "description": "Optional configuration grouping label"
                                }
                            }
                        }
                    },
                    "coglens.artifactOptions": {
                        "type": "object",
                        "scope": "resource",
                        "default": {
                            "assembly": {
                                "intel": false,
                                "demangle": false,
                                "labels": true,
                                "libraryCode": false,
                                "directives": true,
                                "commentOnly": true,
                                "trim": false,
                                "dontMaskFilenames": true
                            },
                            "preprocessed-source": {
                                "showIncludedFiles": true
                            },
                            "ast": {
                                "showSystemDeclarations": false
                            }
                        },
                        "additionalProperties": false,
                        "properties": {
                            "assembly": {
                                "type": "object",
                                "description": "Assembly options",
                                "additionalProperties": false,
                                "properties": {
                                    "intel": {
                                        "type": "boolean",
                                        "default": false,
                                        "description": "Emit Intel syntax when supported by the selected toolchain"
                                    },
                                    "demangle": {
                                        "type": "boolean",
                                        "default": false,
                                        "description": "Run the configured demangler before rendering assembly"
                                    },
                                    "labels": {
                                        "type": "boolean",
                                        "default": true,
                                        "description": "Remove labels that are not referenced"
                                    },
                                    "libraryCode": {
                                        "type": "boolean",
                                        "default": false,
                                        "description": "Hide code from system libraries"
                                    },
                                    "directives": {
                                        "type": "boolean",
                                        "default": true,
                                        "description": "Hide assembler directives"
                                    },
                                    "commentOnly": {
                                        "type": "boolean",
                                        "default": true,
                                        "description": "Remove comment-only lines"
                                    },
                                    "trim": {
                                        "type": "boolean",
                                        "default": false,
                                        "description": "Remove excessive horizontal whitespace"
                                    },
                                    "dontMaskFilenames": {
                                        "type": "boolean",
                                        "default": true,
                                        "description": "Keep source filenames visible in rendered output"
                                    }
                                }
                            },
                            "binary-disassembly": {
                                "type": "object",
                                "description": "Binary disassembly options",
                                "additionalProperties": false,
                                "properties": {
                                    "labels": {
                                        "type": "boolean",
                                        "default": true,
                                        "description": "Remove labels that are not referenced"
                                    },
                                    "libraryCode": {
                                        "type": "boolean",
                                        "default": false,
                                        "description": "Hide code from system libraries"
                                    },
                                    "dontMaskFilenames": {
                                        "type": "boolean",
                                        "default": true,
                                        "description": "Keep source filenames visible in rendered output"
                                    }
                                }
                            },
                            "preprocessed-source": {
                                "type": "object",
                                "description": "Preprocessed source options",
                                "additionalProperties": false,
                                "properties": {
                                    "showIncludedFiles": {
                                        "type": "boolean",
                                        "default": true,
                                        "description": "Include content originating from headers"
                                    }
                                }
                            },
                            "ast": {
                                "type": "object",
                                "description": "Abstract syntax tree options",
                                "additionalProperties": false,
                                "properties": {
                                    "showSystemDeclarations": {
                                        "type": "boolean",
                                        "default": false,
                                        "description": "Include declarations originating from compiler and system headers"
                                    }
                                }
                            },
                            "llvm-ir": {
                                "type": "object",
                                "description": "LLVM IR options",
                                "additionalProperties": false,
                                "properties": {}
                            },
                            "rust-mir": {
                                "type": "object",
                                "description": "Rust MIR options",
                                "additionalProperties": false,
                                "properties": {}
                            },
                            "optimization-remarks": {
                                "type": "object",
                                "description": "Optimization remarks options",
                                "additionalProperties": false,
                                "properties": {}
                            },
                            "python-bytecode": {
                                "type": "object",
                                "description": "Python bytecode options",
                                "additionalProperties": false,
                                "properties": {}
                            }
                        }
                    },
                    "coglens.artifactPresets": {
                        "type": "object",
                        "scope": "resource",
                        "default": {},
                        "description": "Named artifact production presets",
                        "additionalProperties": {
                            "type": "object",
                            "required": [
                                "artifactKind"
                            ],
                            "additionalProperties": false,
                            "properties": {
                                "artifactKind": {
                                    "type": "string",
                                    "enum": [
                                        "assembly",
                                        "binary-disassembly",
                                        "preprocessed-source",
                                        "ast",
                                        "llvm-ir",
                                        "rust-mir",
                                        "optimization-remarks",
                                        "python-bytecode"
                                    ],
                                    "description": "Artifact kind produced by this preset"
                                },
                                "extraArguments": {
                                    "type": "array",
                                    "items": {
                                        "type": "string"
                                    },
                                    "default": [],
                                    "description": "Additional arguments appended to the compilation variant"
                                },
                                "productionOptions": {
                                    "type": "object",
                                    "additionalProperties": false,
                                    "default": {},
                                    "properties": {
                                        "intel": {
                                            "type": "boolean",
                                            "description": "Emit Intel syntax when supported"
                                        },
                                        "demangle": {
                                            "type": "boolean",
                                            "description": "Demangle symbols when supported"
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        ],
        "menus": {
            "editor/title": [
                {
                    "command": "coglens.OpenArtifact",
                    "group": "navigation@1",
                    "when": "resourceScheme == file && coglens.supportedSource"
                },
                {
                    "command": "coglens.PickCompilationVariant",
                    "group": "navigation@2",
                    "when": "resourceScheme == file && coglens.supportedSource"
                },
                {
                    "command": "coglens.CompareArtifacts",
                    "group": "navigation@3",
                    "when": "resourceScheme == file && coglens.supportedSource"
                }
            ],
            "view/title": [
                {
                    "command": "coglens.AddToolchain",
                    "when": "view == coglens.toolchains",
                    "group": "navigation@1"
                },
                {
                    "command": "coglens.OpenToolchainSettingsJson",
                    "when": "view == coglens.toolchains",
                    "group": "navigation@9"
                },
                {
                    "command": "coglens.AddCompilationVariant",
                    "when": "view == coglens.compileInfo",
                    "group": "navigation@1"
                },
                {
                    "command": "coglens.RevealActiveSource",
                    "when": "view == coglens.compileInfo",
                    "group": "navigation@2"
                },
                {
                    "command": "coglens.OpenCompileSettingsJson",
                    "when": "view == coglens.compileInfo",
                    "group": "navigation@9"
                },
                {
                    "command": "coglens.OpenArtifactSettingsJson",
                    "when": "view == coglens.artifactOptions",
                    "group": "navigation@9"
                }
            ],
            "view/item/context": [
                {
                    "command": "coglens.CopyText",
                    "when": "view =~ /^coglens/ && viewItem == text"
                },
                {
                    "command": "coglens.CreateWorkspaceOverride",
                    "when": "view == coglens.toolchains && viewItem == derivedInstance",
                    "group": "inline@1"
                },
                {
                    "command": "coglens.DeleteToolchain",
                    "when": "view == coglens.toolchains && viewItem == userToolchain",
                    "group": "inline@1"
                },
                {
                    "command": "coglens.EditCompilationVariant",
                    "when": "view == coglens.compileInfo && viewItem == compilationVariant",
                    "group": "inline@1"
                },
                {
                    "command": "coglens.AddCompilationVariant",
                    "when": "view == coglens.compileInfo && viewItem == compilationSource",
                    "group": "inline@1"
                },
                {
                    "command": "coglens.EditCompilationVariant",
                    "when": "view == coglens.compileInfo && viewItem == manualCompilationVariant",
                    "group": "inline@1"
                },
                {
                    "command": "coglens.DeleteCompilationVariant",
                    "when": "view == coglens.compileInfo && viewItem == manualCompilationVariant",
                    "group": "inline@2"
                }
            ]
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run package",
        "compile": "npm run check-types && npm run lint && node esbuild.js",
        "watch": "node esbuild.js --watch",
        "watch:esbuild": "node esbuild.js --watch",
        "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
        "package": "npm run check-types && npm run lint && node esbuild.js --production",
        "compile-tests": "tsc -p tsconfig.extension-tests.json",
        "watch-tests": "tsc -p tsconfig.extension-tests.json -w",
        "pretest": "npm run compile-tests && npm run compile && npm run lint",
        "check-types": "tsc --noEmit && tsc --noEmit -p tsconfig.unit.json",
        "lint": "eslint src test",
        "test": "npm run test:unit",
        "test:unit": "node --import tsx --test \"test/**/*.test.ts\"",
        "test:extension": "npm run compile-tests && npm run compile && node scripts/run-extension-tests.mjs",
        "vendor:check": "node scripts/vendor-check.mjs",
        "package:vsix": "vsce package --no-dependencies"
    },
    "dependencies": {
        "@vscode/python-extension": "^1.0.6",
        "vscode-cmake-tools": "^1.7.0",
        "yaml": "^2.9.0"
    },
    "devDependencies": {
        "@types/node": "20.x",
        "@types/vscode": "1.94.0",
        "@typescript-eslint/eslint-plugin": "^8.65.0",
        "@typescript-eslint/parser": "^8.65.0",
        "@vscode/test-electron": "^2.5.2",
        "@vscode/vsce": "^3.6.0",
        "esbuild": "^0.28.1",
        "eslint": "^10.8.0",
        "tsx": "^4.20.3",
        "typescript": "^5.9.3"
    },
	"extensionPack": [
		"13xforever.language-x86-64-assembly",
		"ms-python.python"
	]
}
