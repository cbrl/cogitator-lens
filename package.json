{
  "name": "coglens",
  "displayName": "Cogitator Lens",
  "description": "An extension for inspecting compiler and interpreter artifacts",
  "version": "0.9.0",
  "icon": "resources/gear-phi.png",
  "publisher": "cbrl",
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/cbrl/cogitator-lens"
  },
  "engines": {
    "node": ">=22",
    "vscode": "^1.94.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Cogitator Lens invokes configured toolchains and therefore requires a trusted workspace."
    }
  },
  "categories": [
    "Programming Languages",
    "Visualization",
    "Debuggers"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "zig",
        "aliases": [
          "Zig",
          "zig"
        ],
        "extensions": [
          ".zig"
        ]
      },
      {
        "id": "coglens-asm",
        "aliases": [
          "Compiler Assembly"
        ],
        "extensions": [
          ".asm",
          ".disasm"
        ]
      },
      {
        "id": "coglens-llvm-ir",
        "aliases": [
          "LLVM IR"
        ],
        "extensions": [
          ".ll"
        ]
      },
      {
        "id": "coglens-ast",
        "aliases": [
          "Compiler AST"
        ],
        "extensions": [
          ".ast"
        ]
      },
      {
        "id": "coglens-mir",
        "aliases": [
          "Rust MIR"
        ],
        "extensions": [
          ".mir"
        ]
      }
    ],
    "grammars": [
      {
        "language": "coglens-asm",
        "scopeName": "source.coglens-asm",
        "path": "./syntaxes/coglens-asm.tmLanguage.json"
      },
      {
        "language": "coglens-llvm-ir",
        "scopeName": "source.coglens-llvm-ir",
        "path": "./syntaxes/coglens-llvm-ir.tmLanguage.json"
      },
      {
        "language": "coglens-ast",
        "scopeName": "source.coglens-ast",
        "path": "./syntaxes/coglens-ast.tmLanguage.json"
      },
      {
        "language": "coglens-mir",
        "scopeName": "source.coglens-mir",
        "path": "./syntaxes/coglens-mir.tmLanguage.json"
      }
    ],
    "colors": [
      {
        "id": "coglens.optimizationRemarks.passedBackground",
        "description": "Background color for successful optimization remarks.",
        "defaults": {
          "dark": "#125C12",
          "light": "#A9FFA9",
          "highContrast": "#007F00",
          "highContrastLight": "#B8FFB8"
        }
      },
      {
        "id": "coglens.optimizationRemarks.missedBackground",
        "description": "Background color for missed optimization remarks.",
        "defaults": {
          "dark": "#631E1C",
          "light": "#F8CAC8",
          "highContrast": "#9E0000",
          "highContrastLight": "#FFD6D6"
        }
      },
      {
        "id": "coglens.optimizationRemarks.analysisBackground",
        "description": "Background color for optimization analysis remarks.",
        "defaults": {
          "dark": "#4F4F18",
          "light": "#FFFFAE",
          "highContrast": "#767600",
          "highContrastLight": "#FFFFC8"
        }
      },
      {
        "id": "coglens.stackUsage.background",
        "description": "Background color for stack-usage annotations.",
        "defaults": {
          "dark": "#264F78",
          "light": "#D6EBFF",
          "highContrast": "#005A9C",
          "highContrastLight": "#E1F1FF"
        }
      },
      {
        "id": "coglens.selection.background",
        "description": "Background for selected source-to-artifact mappings.",
        "defaults": {
          "dark": "editor.findMatchHighlightBackground",
          "light": "editor.findMatchHighlightBackground",
          "highContrast": "#00000000",
          "highContrastLight": "#00000000"
        }
      },
      {
        "id": "coglens.selection.overviewRuler",
        "description": "Overview ruler marker for selected mappings.",
        "defaults": {
          "dark": "editorOverviewRuler.findMatchForeground",
          "light": "editorOverviewRuler.findMatchForeground",
          "highContrast": "#FFFF00",
          "highContrastLight": "#0000FF"
        }
      },
      {
        "id": "coglens.sourceRange.background",
        "description": "Background for a precise mapped source range.",
        "defaults": {
          "dark": "editor.wordHighlightStrongBackground",
          "light": "editor.wordHighlightStrongBackground",
          "highContrast": "#00000000",
          "highContrastLight": "#00000000"
        }
      },
      {
        "id": "coglens.sourceRange.border",
        "description": "Border for a precise mapped source range.",
        "defaults": {
          "dark": "editor.wordHighlightStrongBorder",
          "light": "editor.wordHighlightStrongBorder",
          "highContrast": "#FFFF00",
          "highContrastLight": "#0000FF"
        }
      },
      {
        "id": "coglens.sourceRange.overviewRuler",
        "description": "Overview ruler marker for a precise mapped source range.",
        "defaults": {
          "dark": "editorOverviewRuler.wordHighlightStrongForeground",
          "light": "editorOverviewRuler.wordHighlightStrongForeground",
          "highContrast": "#FFFF00",
          "highContrastLight": "#0000FF"
        }
      },
      {
        "id": "coglens.state.foreground",
        "description": "Foreground for artifact state annotations.",
        "defaults": {
          "dark": "descriptionForeground",
          "light": "descriptionForeground",
          "highContrast": "editorWarning.foreground",
          "highContrastLight": "editorWarning.foreground"
        }
      },
      {
        "id": "coglens.binaryColumns.foreground",
        "description": "Foreground for instruction addresses and encoded bytes.",
        "defaults": {
          "dark": "editorLineNumber.foreground",
          "light": "editorLineNumber.foreground",
          "highContrast": "editor.foreground",
          "highContrastLight": "editor.foreground"
        }
      },
      {
        "id": "coglens.binaryColumns.background",
        "description": "Background for instruction addresses and encoded bytes.",
        "defaults": {
          "dark": "#FFFFFF08",
          "light": "#00000008",
          "highContrast": "#00000000",
          "highContrastLight": "#00000000"
        }
      },
      {
        "id": "coglens.sourceLineBand.1Background",
